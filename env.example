AEGIS_ENV=production

# Aegis node
AEGIS_NODE_ID=node-1
AEGIS_NODE_SIGNING_KEY=
AEGIS_NODE_KEY_PATH=/var/data/aegis_node_key.pem
AEGIS_DB_PATH=/var/data/aegis402.db
AEGIS_LEDGER_PATH=/var/data/aegis402_ledger.jsonl

# x402 v2
AEGIS_X402_ADAPTER=facilitator
AEGIS_FACILITATOR_URL=https://x402.org/facilitator
AEGIS_X402_VERSION=2
AEGIS_X402_NETWORK=eip155:84532
AEGIS_X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
AEGIS_DEMO_PAY_TO=
AEGIS_DEMO_PRICE=1000

# RPC and independent settlement observation
AEGIS_RPC_URL=https://sepolia.base.org
AEGIS_SETTLEMENT_CONFIRMATIONS=1

# Administrator authentication. Never commit real values.
AEGIS_REQUIRE_ADMIN_AUTH=true
AEGIS_ADMIN_PASSWORD=
AEGIS_ADMIN_SESSION_SECRET=
AEGIS_ADMIN_TOKEN=
AEGIS_SECURITY_TOKEN=
AEGIS_POLICY_TOKEN=
AEGIS_AUDITOR_TOKEN=
AEGIS_OPERATOR_TOKEN=

# Optional external AI risk provider
AEGIS_AI_RISK_URL=
AEGIS_AI_RISK_REQUIRED=false
AEGIS_AI_RISK_TIMEOUT=2.0
AEGIS_AI_RISK_MODEL=

# Distributed node controls
AEGIS_PEER_BOOTSTRAP_TOKEN=
AEGIS_REQUIRE_SIGNED_THREATS=true
AEGIS_MAX_PEER_REPORT_BYTES=65536
AEGIS_MAX_PEER_REPORTS_PER_MINUTE=60
AEGIS_MAX_CLOCK_SKEW_SECONDS=120
AEGIS_PEER_TIMEOUT_SECONDS=3

# External anchoring; leave local until a reviewed contract is deployed
AEGIS_ANCHOR_BACKEND=local
AEGIS_ANCHOR_CONTRACT=
AEGIS_ANCHOR_PRIVATE_KEY=
